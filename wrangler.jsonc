{
  // Nordvy på Cloudflare Workers. Varje commit till main publiceras automatiskt.
  "name": "nordvy",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  // Hela sajten ligger i public/. Workern körs först så att den kan sätta
  // säkerhetsrubriker och fylla i sajtens adress i HTML-filerna.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Workers AI driver självintervjun. Gratisnivån är 10 000 neuroner per dygn.
  // Tar de slut fortsätter intervjun med checklistans färdiga frågor.
  "ai": { "binding": "AI" },

  // Högst 30 anrop per minut och besökare till /api.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  "vars": {
    // Modellen som ställer frågorna och skriver utkastet.
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Google Apps Script som mejlar formulär och underlag till Nordvyuf@gmail.com.
    "CONTACT_ENDPOINT": "https://script.google.com/macros/s/AKfycbyaHYnnZe3xiOlYQmhCcOokTQEq14nSBq7rZo2KAWSxX_n0oknz774UO0e-Zm9jnpz1/exec",
    // Den riktiga adressen, som används i delningsbilder, canonical, robots.txt och sitemap.
    // Tom = adressen besökaren använder (så är det på förhandsvisningarna).
    "SITE_URL": "https://nordvyuf.se"
  },

  // Förhandsvisningar (en per förfrågan på GitHub) byggs med "wrangler preview",
  // som kräver egna värden här. Förhandsvisningen använder samma mejlskript som
  // riktiga sidan, så testmejl hamnar i Nordvyuf@gmail.com och räknas mot de 30 per dag.
  "previews": {
    "vars": {
      "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
      "CONTACT_ENDPOINT": "https://script.google.com/macros/s/AKfycbyaHYnnZe3xiOlYQmhCcOokTQEq14nSBq7rZo2KAWSxX_n0oknz774UO0e-Zm9jnpz1/exec",
      "SITE_URL": ""
    },
    "ratelimits": [
      { "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
    ],
    "ai": { "binding": "AI" }
  },

  "observability": { "enabled": true }
}
